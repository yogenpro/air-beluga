{
  "name": "air-beluga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev --env=\"\"",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod",
    "deploy:check": "wrangler deploy --dry-run --env=\"\" && wrangler deploy --dry-run --env dev && wrangler deploy --dry-run --env prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node --import tsx scripts/browser-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "content:freeze": "node --import tsx scripts/freeze-content.ts",
    "play:stage": "node --import tsx scripts/play-stage.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "playwright": "1.62.1",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "7.3.6",
    "vitest": "4.0.18",
    "wrangler": "4.152.0"
  }
}
